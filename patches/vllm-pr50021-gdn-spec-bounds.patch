+        dst_state_batch_indices=dst_state_batch_indices,
+        out=out,
+        num_accepted_tokens=torch.tensor(
+            [seq_len + 1], dtype=torch.int32, device=DEVICE
+        ),
+        cu_seqlens=torch.tensor([0, seq_len], dtype=torch.int32, device=DEVICE),
